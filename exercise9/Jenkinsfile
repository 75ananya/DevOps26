pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
            }
        }
        stage('Test') {
            steps {
                dir('exercise9') {
                    echo 'Running tests...'
                    sh 'python3 -m unittest discover -s .'
                }
            }
        }
        stage('Deploy') {
            steps {
                dir('exercise9') {
                    echo 'Deploying application...'
                    sh '''
                    mkdir -p python-app-deploy
                    cp app.py python-app-deploy/
                    '''
                }
            }
        }
        stage('Run Application') {
            steps {
                dir('exercise9') {
                    echo 'Running application...'
                    sh '''
                    JENKINS_NODE_COOKIE=dontKillMe nohup python3 python-app-deploy/app.py > python-app-deploy/app.log 2>&1 &
                    echo $! > python-app-deploy/app.pid
                    '''
                }
            }
        }
        stage('Test Application') {
            steps {
                dir('exercise9') {
                    echo 'Testing application...'
                    sh 'python3 test_app.py'
                }
            }
        }
    }
    post {
        success { echo 'Pipeline completed successfully!' }
        failure { echo 'Pipeline failed. Check the logs for more details.' }
    }
}
